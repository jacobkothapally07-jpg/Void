# JARVIS Environment Configuration

# 1. LLM Brain Provider: 'gemini', 'ollama', or 'openai'
LLM_PROVIDER=gemini

# 2. Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# 3. Local Ollama Settings (if using LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 4. Mobile Push Notifications via ntfy.sh (Choose a unique secret topic name)
# Download the 'ntfy' app on iOS / Android and subscribe to this exact topic!
NTFY_TOPIC=jarvis_user_updates_demo
